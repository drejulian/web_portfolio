rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /cv/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.contentType == 'application/pdf';
    }

    match /projects/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.contentType.matches('image/.*');
    }
  }
}
